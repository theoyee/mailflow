# Gemini API Key for AI email generation and assistant
GEMINI_API_KEY=

# Neon PostgreSQL Database Configuration (Connection String or Host credentials)
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
NEON_DATABASE_URL=

# Or discrete PostgreSQL credentials:
SQL_HOST=
SQL_USER=
